.header {
  position: relative;
  z-index: 20;
  background: #f4f6f8;
}

.header-main {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
}

.header-title {
  position: absolute;
  left: 50%;
  max-width: 360rpx;
  overflow: hidden;
  font-size: 32rpx;
  font-weight: 750;
  text-overflow: ellipsis;
  white-space: nowrap;
  transform: translateX(-50%);
}

.header-placeholder {
  width: 76rpx;
  height: 76rpx;
}

.ledger-pill {
  display: flex;
  align-items: center;
  max-width: 460rpx;
  height: 76rpx;
  padding: 0 18rpx 0 10rpx;
  border: 2rpx solid #e1e6eb;
  border-radius: 20rpx;
  background: #fff;
}

.ledger-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  margin-right: 12rpx;
  border-radius: 14rpx;
  background: #8f4ff6;
  color: #fff;
  font-size: 24rpx;
  font-weight: 750;
}

.ledger-name {
  max-width: 310rpx;
  overflow: hidden;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ledger-caret {
  margin-left: 12rpx;
  color: #6f7888;
}

.ai-button,
.header-back {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border: 2rpx solid #ffd8c5;
  border-radius: 20rpx;
  background: #fff2eb;
  color: #b94712;
  font-size: 24rpx;
  font-weight: 800;
}

.header-back {
  border-color: #e1e6eb;
  background: #fff;
  color: #182133;
  font-size: 54rpx;
  font-weight: 400;
}
