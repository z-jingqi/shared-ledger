.form-screen {
  min-height: 100vh;
  background: #f4f6f8;
}

.form-scroll {
  height: calc(100vh - 112rpx - env(safe-area-inset-top));
}

.form-content {
  padding: 18rpx 24rpx calc(38rpx + env(safe-area-inset-bottom));
}

.type-switch {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10rpx;
  padding: 8rpx;
  border: 2rpx solid #e2e6eb;
  border-radius: 22rpx;
  background: #edf0f4;
}

.type-switch button {
  height: 72rpx;
  border-radius: 16rpx;
  color: #788395;
  font-weight: 700;
}

.type-switch button.active {
  background: #ff681c;
  color: #fff;
}

.amount-block {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 32rpx 8rpx 26rpx;
}

.amount-block text,
.field-label {
  color: #6f7a8c;
  font-size: 24rpx;
  font-weight: 650;
}

.amount-block .amount-value {
  font-size: 72rpx;
  font-weight: 800;
  line-height: 1.15;
}

.category-scroll {
  width: 100%;
  margin: 16rpx 0 28rpx;
}

.category-list {
  display: flex;
  gap: 14rpx;
  min-width: max-content;
}

.category-button {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 112rpx;
  height: 68rpx;
  padding: 0 18rpx;
  border: 2rpx solid #e2e6eb;
  border-radius: 18rpx;
  background: #fff;
  font-size: 24rpx;
}

.category-button .category-color {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.category-button.active {
  border-color: #ff681c;
  background: #fff3ec;
  color: #d84f12;
  font-weight: 700;
}

.form-row,
.note-input,
.detail-button {
  width: 100%;
  border: 2rpx solid #e2e6eb;
  border-radius: 20rpx;
  background: #fff;
}

.item-list {
  overflow: hidden;
  margin-top: 16rpx;
  border: 2rpx solid #e2e6eb;
  border-radius: 20rpx;
  background: #fff;
}

.item-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) max-content 48rpx;
  align-items: baseline;
  gap: 14rpx;
  padding: 18rpx 22rpx;
  border-bottom: 2rpx solid #edf0f3;
}

.item-row:last-child {
  border-bottom: 0;
}

.item-row button {
  color: #df4540;
  font-size: 30rpx;
}

.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 84rpx;
  padding: 0 24rpx;
}

.form-row picker {
  color: #566174;
  font-size: 25rpx;
}

.note-input {
  min-height: 92rpx;
  margin-top: 16rpx;
  padding: 24rpx;
  font-size: 26rpx;
}

.detail-button {
  height: 78rpx;
  margin-top: 16rpx;
  color: #ff681c;
  font-size: 24rpx;
  font-weight: 700;
}

.keypad {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin-top: 24rpx;
}

.keypad button {
  height: 74rpx;
  border: 2rpx solid #e2e6eb;
  border-radius: 14rpx;
  background: #fff;
  font-size: 30rpx;
  font-weight: 650;
}

.save-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  margin-top: 22rpx;
  border-radius: 22rpx;
  background: #ff681c;
  color: #fff;
  font-size: 28rpx;
  font-weight: 750;
}
