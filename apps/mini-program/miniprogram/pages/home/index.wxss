.home-loading {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.hero-skeleton {
  height: 300rpx;
}

.row-skeleton {
  height: 108rpx;
}

.balance-card {
  padding: 28rpx;
}

.balance-label {
  display: block;
  color: #566174;
  font-size: 26rpx;
  font-weight: 650;
}

.balance-total {
  display: block;
  margin: 14rpx 0 26rpx;
  font-size: 68rpx;
  font-weight: 800;
  letter-spacing: -3rpx;
}

.balance-metrics {
  display: flex;
  border-top: 2rpx solid #e8ebef;
}

.balance-metrics view {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 8rpx;
  padding: 20rpx 18rpx 0;
  border-right: 2rpx solid #e8ebef;
}

.balance-metrics view:first-child {
  padding-left: 0;
}

.balance-metrics view:last-child {
  border-right: 0;
}

.balance-metrics text {
  color: #7e8797;
  font-size: 23rpx;
}

.balance-metrics .metric-value {
  font-size: 28rpx;
  font-weight: 700;
}

.expense {
  color: #ef5b55;
}

.income {
  color: #159b58;
}

.today-card,
.task-card {
  display: flex;
  align-items: center;
  width: 100%;
  margin-top: 22rpx;
  padding: 22rpx 24rpx;
  text-align: left;
}

.today-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  margin-right: 20rpx;
  border-radius: 18rpx;
  background: #fff0e8;
  color: #ff681c;
  font-weight: 750;
}

.today-card > view:nth-child(2),
.task-card > view {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 6rpx;
}

.today-title,
.task-title {
  font-weight: 750;
}

.today-copy,
.task-card view text:last-child {
  color: #8490a1;
  font-size: 23rpx;
}

.today-action {
  color: #ff681c;
  font-size: 24rpx;
  font-weight: 700;
}

.task-card > text {
  color: #7d8798;
  font-size: 38rpx;
}

.transaction-list {
  overflow: hidden;
}
