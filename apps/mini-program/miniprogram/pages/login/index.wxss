.login-screen {
  min-height: 100vh;
  padding-right: 44rpx;
  padding-left: 44rpx;
  background: #fff;
}

.brand-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  margin-top: 100rpx;
  border-radius: 26rpx;
  background: #ff681c;
  color: #fff;
  font-size: 44rpx;
  font-weight: 800;
}

.login-copy {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 42rpx;
}

.login-title {
  font-size: 58rpx;
  font-weight: 800;
  letter-spacing: -2rpx;
}

.login-subtitle {
  color: #7b8595;
  font-size: 28rpx;
}

.login-card {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  margin-top: 72rpx;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  font-size: 25rpx;
  font-weight: 650;
}

.field input {
  height: 96rpx;
  padding: 0 28rpx;
  border: 2rpx solid #e2e6eb;
  border-radius: 22rpx;
  background: #f8f9fa;
  font-size: 29rpx;
  font-weight: 400;
}

.login-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  margin-top: 12rpx;
  border-radius: 24rpx;
  background: #ff681c;
  color: #fff;
  font-size: 30rpx;
  font-weight: 750;
}

.form-error {
  margin-top: -10rpx;
  color: #d83d38;
  font-size: 24rpx;
}

.login-note {
  position: fixed;
  right: 44rpx;
  bottom: calc(36rpx + env(safe-area-inset-bottom));
  left: 44rpx;
  color: #a0a7b2;
  font-size: 21rpx;
  text-align: center;
}
