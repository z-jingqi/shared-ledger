.login-screen {
  display: flex;
  box-sizing: border-box;
  flex-direction: column;
  min-height: 100vh;
  padding-right: 44rpx;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
  padding-left: 44rpx;
  background: #f7f8fa;
}

.login-main {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  padding-bottom: 80rpx;
}

.brand-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 124rpx;
  height: 124rpx;
  border: 2rpx solid #e2e6eb;
  border-radius: 30rpx;
  background: #fff;
  color: #ff681c;
  font-size: 48rpx;
  font-weight: 850;
}

.login-copy {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  margin-top: 30rpx;
  text-align: center;
}

.login-title {
  color: #111827;
  font-size: 48rpx;
  font-weight: 900;
  letter-spacing: -1rpx;
}

.login-subtitle {
  color: #7b8595;
  font-size: 27rpx;
  line-height: 1.55;
}

.login-card {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  width: 100%;
  margin-top: 50rpx;
}

.login-button,
.preview-button {
  display: flex;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  width: 100%;
  margin: 0;
  border-radius: 22rpx;
  font-size: 28rpx;
  font-weight: 750;
}

.login-button {
  height: 94rpx;
  background: #ff681c;
  color: #fff;
}

.preview-button {
  height: 82rpx;
  border: 0;
  background: transparent;
  color: #657083;
}

.form-error {
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  background: #fff0ef;
  color: #d83d38;
  font-size: 24rpx;
  line-height: 1.45;
  text-align: center;
}

.login-note {
  color: #9aa2af;
  font-size: 21rpx;
  line-height: 1.5;
  text-align: center;
}
