<view class="login-screen" style="padding-top: {{statusBarHeight}}px;">
  <view class="login-main">
    <view class="brand-mark">账</view>
    <view class="login-copy">
      <text class="login-title">欢迎回来</text>
      <text class="login-subtitle">登录后继续维护你和家人的共享账本</text>
    </view>
    <view class="login-card">
      <text wx:if="{{error}}" class="form-error">{{error}}</text>
      <button class="login-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="onWechatLogin">微信一键登录</button>
      <button class="preview-button" disabled="{{submitting}}" bindtap="onPreview">暂不登录，先预览</button>
    </view>
  </view>
  <text class="login-note">登录后会自动创建你的个人账本；我们不会获取微信聊天内容</text>
</view>
