<view class="tab-shell">
  <view class="tab-group">
    <view
      wx:for="{{leftTabs}}"
      wx:key="pagePath"
      class="tab-item {{selected === item.index ? 'active' : ''}}"
      data-index="{{item.index}}"
      bindtap="onSwitch"
    >
      <text class="tab-icon">{{item.icon}}</text>
      <text>{{item.text}}</text>
    </view>
  </view>
  <view class="add-button" role="button" aria-label="记一笔" bindtap="onAdd"><text class="add-icon">＋</text></view>
  <view class="tab-group">
    <view
      wx:for="{{rightTabs}}"
      wx:key="pagePath"
      class="tab-item {{selected === item.index ? 'active' : ''}}"
      data-index="{{item.index}}"
      bindtap="onSwitch"
    >
      <text class="tab-icon">{{item.icon}}</text>
      <text>{{item.text}}</text>
    </view>
  </view>
</view>
