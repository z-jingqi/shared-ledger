{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "shared-ledger-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-21",
  "workers_dev": true,
  "vars": {
    "APP_ENV": "local",
    "WEB_ORIGIN": "http://localhost:5175",
    "AI_PROVIDER": "openrouter",
  },
  "limits": { "cpu_ms": 300000 },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shared-ledger-local",
      "database_id": "local",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "shared-ledger-local-files" }],
  "queues": {
    "producers": [
      {
        "binding": "IMPORT_PIPELINE_QUEUE",
        "queue": "shared-ledger-import-pipeline-local",
      },
    ],
    "consumers": [
      {
        "queue": "shared-ledger-import-pipeline-local",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "shared-ledger-import-pipeline-local-dlq",
        "max_concurrency": 1,
      },
    ],
  },
}
