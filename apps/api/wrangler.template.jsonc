{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "shared-ledger-api-__ENV__",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-21",
  "workers_dev": true,
  "vars": {
    "APP_ENV": "__ENV__",
    "WEB_ORIGIN": "__WEB_ORIGIN__",
    "AI_PROVIDER": "__AI_PROVIDER__",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shared-ledger-__ENV__",
      "database_id": "__D1_DATABASE_ID__",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "__R2_BUCKET__" }],
  "queues": {
    "producers": [
      {
        "binding": "IMPORT_PIPELINE_QUEUE",
        "queue": "__IMPORT_PIPELINE_QUEUE__",
      },
    ],
    "consumers": [
      {
        "queue": "__IMPORT_PIPELINE_QUEUE__",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "__IMPORT_PIPELINE_DLQ__",
        "max_concurrency": 1,
      },
    ],
  },
  "routes": [{ "pattern": "__WEB_DOMAIN__/api/*", "zone_name": "__ZONE_NAME__" }],
}
